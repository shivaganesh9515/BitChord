<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 and newer; see
   backup_rules.xml for why these files are excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="slickchord_auth.xml" />
        <exclude domain="sharedpref" path="slickchord_auth_plain.xml" />
        <exclude domain="sharedpref" path="slickchord_sources.xml" />
        <exclude domain="sharedpref" path="slickchord_sources_plain.xml" />
        <!-- Playback queues are local session state; do not resurrect them after reinstall. -->
        <exclude domain="sharedpref" path="slickchord_last_played.xml" />
        <exclude domain="sharedpref" path="slickchord_bounded_context.xml" />
        <exclude domain="sharedpref" path="slickchord_party_queue_stash.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="slickchord_auth.xml" />
        <exclude domain="sharedpref" path="slickchord_auth_plain.xml" />
        <exclude domain="sharedpref" path="slickchord_sources.xml" />
        <exclude domain="sharedpref" path="slickchord_sources_plain.xml" />
        <!-- Playback queues are local session state; do not resurrect them after reinstall. -->
        <exclude domain="sharedpref" path="slickchord_last_played.xml" />
        <exclude domain="sharedpref" path="slickchord_bounded_context.xml" />
        <exclude domain="sharedpref" path="slickchord_party_queue_stash.xml" />
    </device-transfer>
</data-extraction-rules>
